# Generate a long random secret before deployment.
SECRET_KEY=replace-with-a-long-random-secret
# Local default is SQLite. For production, use a managed PostgreSQL database and set DATABASE_URL.
# DATABASE_URL=postgresql://user:password@host:5432/metervault
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-10-characters
COOKIE_SECURE=0
