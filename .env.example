# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
# Production must use PostgreSQL and HTTPS.
APP_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/metervault
BOOTSTRAP_ADMIN_USER=replace-with-a-unique-admin-name
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-14-characters
COOKIE_SECURE=1
